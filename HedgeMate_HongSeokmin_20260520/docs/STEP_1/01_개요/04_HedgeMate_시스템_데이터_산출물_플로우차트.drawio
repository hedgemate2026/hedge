  <diagram id="7f395621d1d9" name="02_데이터흐름">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="HedgeMate 데이터 처리 및 분석 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="시장데이터/환율/벤치마크를 KRW 기준으로 정규화한 뒤 리스크 분석과 헷지 추천으로 연결" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="860" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;1. 입력 데이터&lt;/b&gt;&lt;br/&gt;• 자산 유니버스 메타&lt;br/&gt;• 사용자 단일 자산 입력&lt;br/&gt;• 사용자 포트폴리오 입력" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;2. 데이터 확보&lt;/b&gt;&lt;br/&gt;• 시장 가격 데이터 확보&lt;br/&gt;• FX 데이터 확보&lt;br/&gt;• 벤치마크 데이터 확보" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="6" value="기존 raw snapshot 존재?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="390" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;캐시 재사용&lt;/b&gt;&lt;br/&gt;기존 raw / FX / benchmark 활용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="520" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;신규 수집&lt;/b&gt;&lt;br/&gt;외부 시세 기반 raw 데이터 생성" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="520" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;3. 분석 대상 시계열 확보&lt;/b&gt;&lt;br/&gt;• 가격/환율/벤치마크 스냅샷 확정&lt;br/&gt;• run_id 기준 재현성 확보" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="650" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;4. KRW 정규화&lt;/b&gt;&lt;br/&gt;• USD 자산 → KRW 환산&lt;br/&gt;• 시계열 정렬&lt;br/&gt;• 수익률 시계열 생성" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="800" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;5. 데이터 품질 검사 (DQ)&lt;/b&gt;&lt;br/&gt;• 결측치 / coverage&lt;br/&gt;• invalid price / duplicate / outlier&lt;br/&gt;• FX 미매칭 → PASS/WARN/FAIL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="950" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;6. 리스크 피처 계산&lt;/b&gt;&lt;br/&gt;• Vol / MDD / VaR / CVaR&lt;br/&gt;• Beta / Downside Beta / Corr&lt;br/&gt;• Stress 수익률 / Sharpe proxy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1110" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;7. 자산 민감도 및 후보 선별&lt;/b&gt;&lt;br/&gt;• direction / magnitude / sensitivity level&lt;br/&gt;• HES 기반 후보 압축" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1270" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;8. 헷지 조합 평가&lt;/b&gt;&lt;br/&gt;• 1:1 조합 생성&lt;br/&gt;• 다자산 조합 생성&lt;br/&gt;• 기준안 vs 제안안 비교" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1420" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Gate 통과 여부?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="1555" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;추천안&lt;/b&gt;&lt;br/&gt;PASS 조합 선택&lt;br/&gt;최종 랭킹 반영" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;" vertex="1" parent="1">

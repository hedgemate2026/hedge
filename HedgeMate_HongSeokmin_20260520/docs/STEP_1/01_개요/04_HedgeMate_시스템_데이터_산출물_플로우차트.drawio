  <diagram id="7ff5a01fde27" name="01_시스템흐름">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="HedgeMate 전체 시스템 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="사용자 입력 → 분석 엔진 → 추천 결과 → 산출물 → 대시보드 시각화" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;1. 사용자 입력&lt;/b&gt;&lt;br/&gt;• 단일 자산 입력&lt;br/&gt;• 포트폴리오 입력&lt;br/&gt;• KRW 기준 예산 입력" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;2. 입력 해석 및 분석 요청&lt;/b&gt;&lt;br/&gt;• 자산명/티커 정규화&lt;br/&gt;• 입력 형식 검증&lt;br/&gt;• 분석 모드 결정" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;3. HedgeMate 분석 엔진&lt;/b&gt;&lt;br/&gt;• 데이터 로드/재사용&lt;br/&gt;• KRW 기준 분석&lt;br/&gt;• 리스크 측정 및 후보 평가" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="180" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;4. 추천안 / 참고안 생성&lt;/b&gt;&lt;br/&gt;• 1:1 헷지&lt;br/&gt;• 다자산 헷지&lt;br/&gt;• Gate 판정 및 최종 랭킹" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="180" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;5. 결과 산출물 생성&lt;/b&gt;&lt;br/&gt;• CSV 저장&lt;br/&gt;• 실행 결과 기록&lt;br/&gt;• 분석 리포트/검토 문서 생성" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="180" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;6. 대시보드 시각화&lt;/b&gt;&lt;br/&gt;• 비교 결과 표시&lt;br/&gt;• 추천 자산배분 표시&lt;br/&gt;• 상위 후보/민감도 표시" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1490" y="180" width="180" height="120" as="geometry" />
